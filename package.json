{
  "name": "opencode-pet",
  "version": "1.0.5",
  "description": "Bring Codex pets to OpenCode — animated terminal companions that appear while models think",
  "type": "module",
  "types": "./src/plugin/index.tsx",
  "main": "./dist/plugin/index.js",
  "bin": {
    "opencode-pet": "dist/cli/index.js"
  },
  "exports": {
    "./tui": "./dist/plugin/index.js"
  },
  "files": [
    "src/plugin",
    "src/converter",
    "src/types.ts",
    "dist/cli",
    "dist/converter",
    "dist/plugin",
    "dist/types.js",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node ./scripts/build-plugin.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.plugin.json",
    "generate-default-pet": "node ./scripts/generate-default-pet.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "codex",
    "pet",
    "companion",
    "terminal",
    "animation",
    "thinking",
    "ai",
    "open source"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aramirez087/opencode-pet.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@opentui/core": "0.4.5",
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-typescript": "^7.29.7",
    "@opencode-ai/plugin": "1.19.5",
    "@opentui/solid": "0.4.5",
    "@types/node": "^24.19.2",
    "babel-preset-solid": "1.9.12",
    "esbuild": "^0.28.2",
    "solid-js": "1.9.12",
    "typescript": "^5.9.3"
  }
}
